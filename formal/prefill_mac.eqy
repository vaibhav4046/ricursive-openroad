# Run from v2/ directory after installing eqy + Yosys + supported SMT engine.
# Different module names are intentional: the same named ports are compared.
[gold]
read_verilog -sv rtl/prefill_mac_tile.sv
prep -top prefill_mac_tile_gold
rename -top prefill_mac_tile

[gate]
read_verilog -sv rtl/prefill_mac_tile.sv
prep -top prefill_mac_tile_gate
rename -top prefill_mac_tile

[collect *]

[strategy sby]
use sby
depth 20
engine smtbmc z3
